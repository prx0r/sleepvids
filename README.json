{
  "version": "1.0.0",
  "updated": "2026-09-27",
  "description": "sleepvids — video production graph. Every entity is a node. Every relationship is an edge. Queryable as a graph database.",

  "query_examples": {
    "get_all_channels": "graph.nodes[?type=='channel']",
    "get_channel_videos": "graph.edges[?relation=='belongs_to' && from=='channel:agi_scenarios']",
    "get_video_sources": "graph.edges[?relation=='uses_source' && from=='video:agi_scenarios:001']",
    "get_shelf_channels": "graph.edges[?relation=='on_shelf' && to=='shelf:mind']",
    "get_voice_videos": "graph.edges[?relation=='narrated_by' && to=='voice:lecturer']",
    "get_mechanism_channels": "graph.edges[?relation=='uses_mechanism' && to=='mechanism:difficulty_lullaby']",
    "get_all_sources": "graph.nodes[?type=='source']",
    "get_video_by_id": "graph.nodes['video:agi_scenarios:001']"
  },

  "structure": {
    "graph.json": "All nodes and edges. The single source of truth.",
    "templates/video.json": "Video template with placeholders.",
    "templates/deep_etymology_v2.json": "2-hour essay template with 6 sections, WPM targets, tone rules.",
    "channels/{name}/videos/{seq}_{title}.json": "Individual video definitions.",
    "channels/{name}/channel.yaml": "Channel configuration (human-readable)."
  },

  "process_notes": {
    "etymology_channel": {
      "status": "active",
      "template": "templates/deep_etymology_v2.json",
      "completed_videos": ["vegetable"],
      "pipeline": "1. Etymonline + Wiktionary (roots/cognates) → 2. Aristotle/philosophy passages → 3. Historical timeline → 4. Modern science → 5. Weave into 6-section essay → 6. NoSlop check",
      "word_pool": ["vegetable", "algorithm", "silly", "nice", "panic", "salary", "companion", "disaster", "trivial", "sanguine"],
      "research_sources": {
        "etymonline": "https://www.etymonline.com",
        "wiktionary": "https://en.wiktionary.org",
        "gutenberg": "https://www.gutenberg.org",
        "pubmed": "https://pubmed.ncbi.nlm.nih.gov"
      },
      "voice_clone_approach": "Qwen3-TTS with reference audio per channel (not per video)"
    }
  }
}
