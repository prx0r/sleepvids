  "description": "sleepvids — video production graph. Every entity is a node. Every relationship is an edge. Queryable as a graph database.",

  "schema": {
    "nodes": {
      "channel": {"id": "channel:{name}", "fields": ["name", "shelf", "engine", "voice", "mechanism", "status"]},
      "video": {"id": "video:{channel}:{seq}", "fields": ["title", "script", "metadata", "sources", "status"]},
      "source": {"id": "source:{name}", "fields": ["url", "license", "cost", "content_type"]},
      "voice": {"id": "voice:{name}", "fields": ["persona", "accent", "pitch", "pace", "mood"]},
      "mechanism": {"id": "mechanism:{name}", "fields": ["description", "channels"]},
      "shelf": {"id": "shelf:{name}", "fields": ["channels", "accent", "voice_primary"]}
    },
    "edges": [
      {"from": "video", "to": "channel", "relation": "belongs_to"},
      {"from": "video", "to": "source", "relation": "uses_source"},
      {"from": "video", "to": "voice", "relation": "narrated_by"},
      {"from": "channel", "to": "shelf", "relation": "on_shelf"},
      {"from": "channel", "to": "mechanism", "relation": "uses_mechanism"},
      {"from": "channel", "to": "voice", "relation": "primary_voice"},
      {"from": "video", "to": "video", "relation": "variant_of"}
    ]
  },

