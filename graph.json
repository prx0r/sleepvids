{
  "version": "1.0.0",
  "updated": "2026-09-27",
  "description": "sleepvids — video production graph. Engines are pipelines. Channels are filters. Videos are outputs.",

  "engines": {
    "E1_hosted_music": {
      "id": "E1",
      "name": "hosted-music",
      "description": "Host intro + music whole + host bridges + wedge every frame + goodnight ritual",
      "stages": [
        {"name": "source", "input": "PD/MIDI audio or Suno/ACE renders", "output": "raw_audio"},
        {"name": "script", "input": "lore/theory scripts", "output": "script"},
        {"name": "tts", "input": "script + voice_config", "output": "narration"},
        {"name": "mix", "input": "raw_audio + narration", "output": "mixed_audio"},
        {"name": "render", "input": "mixed_audio + visual_config", "output": "video"}
      ],
      "contract": "Voice in gaps, never over music. Host intro, bridges, goodnight ritual.",
      "serves": ["composer_evenings", "sleepy_covers", "deconstructed", "classical_charts"],
      "status": "proven_once"
    },
    "E2_reading": {
      "id": "E2",
      "name": "reading",
      "description": "Slow TTS + ambient bed + one whiteboard scene per passage",
      "stages": [
        {"name": "corpus", "input": "verified PD text", "output": "text_segments"},
        {"name": "tts", "input": "text_segments + voice_config", "output": "narration"},
        {"name": "ambient", "input": "bed_recipe", "output": "ambient_bed"},
        {"name": "mix", "input": "narration + ambient_bed", "output": "mixed_audio"},
        {"name": "render", "input": "mixed_audio + visual_config", "output": "video"}
      ],
      "contract": "Slow TTS at 0.7x pace. Ambient bed at 35% volume. One visual per passage.",
      "serves": ["steiner", "daimon", "channeled", "alchemy", "angel", "kashmir", "sufi", "fairy_tales", "folklore"],
      "status": "built"
    },
    "E3_guided": {
      "id": "E3",
      "name": "guided",
      "description": "Yoga-nidra narration over drone + near-static visual. No plot, only descent.",
      "stages": [
        {"name": "cosmology", "input": "cosmology_map", "output": "journey_script"},
        {"name": "tts", "input": "journey_script + voice_config", "output": "narration"},
        {"name": "drone", "input": "drone_recipe", "output": "drone_bed"},
        {"name": "mix", "input": "narration + drone_bed", "output": "mixed_audio"},
        {"name": "render", "input": "mixed_audio + near_static_visual", "output": "video"}
      ],
      "contract": "No plot. Only descent. Drone bed, no captions.",
      "serves": ["daimon_encounters", "manifestation", "theurgy", "kabbalah_tree", "spanda_body"],
      "status": "scripts_only"
    },
    "E4_ambience": {
      "id": "E4",
      "name": "ambience",
      "description": "Synthesized bed + slow visual loop + ship. Cheapest per hour.",
      "stages": [
        {"name": "source", "input": "place + bed_recipe", "output": "ambient_bed"},
        {"name": "visual", "input": "visual_config", "output": "visual_loop"},
        {"name": "ship", "input": "ambient_bed + visual_loop", "output": "video"}
      ],
      "contract": "The room IS the content. No narration. Synthesized or sourced ambient.",
      "serves": ["fly_on_wall", "anti_sleep_war", "anti_sleep_arguing", "rain_variants"],
      "status": "unbuilt"
    },
    "E5_talk": {
      "id": "E5",
      "name": "talk",
      "description": "Research brief + host essay + whiteboard diagrams. For topics, not texts.",
      "stages": [
        {"name": "research", "input": "topic + sources", "output": "research_brief"},
        {"name": "script", "input": "research_brief", "output": "script"},
        {"name": "tts", "input": "script + voice_config", "output": "narration"},
        {"name": "ambient", "input": "bed_recipe", "output": "ambient_bed"},
        {"name": "mix", "input": "narration + ambient_bed", "output": "mixed_audio"},
        {"name": "render", "input": "mixed_audio + visual_config", "output": "video"}
      ],
      "contract": "Essay format. Research-driven. Same renderer as E2 but with research stage.",
      "serves": ["agi_scenarios", "sleepy_maths", "etymology", "sleepy_periodic", "good_news"],
      "status": "built"
    },
    "E6_freshness": {
      "id": "E6",
      "name": "freshness",
      "description": "Web scan → brief → E5 render, same-day. For daily content.",
      "stages": [
        {"name": "scan", "input": "query_packs", "output": "raw_stories"},
        {"name": "filter", "input": "raw_stories + filter_rules", "output": "curated_stories"},
        {"name": "brief", "input": "curated_stories", "output": "daily_brief"},
        {"name": "render", "input": "daily_brief + E5_pipeline", "output": "video"}
      ],
      "contract": "Daily scan → brief → render. Same-day production.",
      "serves": ["good_news"],
      "status": "scan_only"
    }
  },

  "channels": {
